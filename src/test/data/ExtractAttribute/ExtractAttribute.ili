INTERLIS 2.4;

MODEL TestSuite
  AT "mailto:info@geowerkstatt.ch" VERSION "2025-05-26" =
  IMPORTS GeoW_FunctionsExt;

  FUNCTION elementCount (bag: BAG OF ANYSTRUCTURE): NUMERIC;

  TOPIC FunctionTestTopic =

    DOMAIN
        !!@CRS=EPSG:2056
        Coord2 = COORD
          2460000.000 .. 2870000.000,
          1045000.000 .. 1310000.000,
          ROTATION 2 -> 1;

    CLASS Component =
      Name: MANDATORY TEXT;
      Attr: TEXT;
      Geom: Coord2;
    END Component;

    CLASS TestCase =
      description: MANDATORY TEXT;
      path: TEXT;
      objectName: MANDATORY TEXT;
      expectedCount: MANDATORY 0..100;
      !!@ ilivalid.msg = "TestCase '{description}' failed."
      MANDATORY CONSTRAINT testCase:
        elementCount(
          GeoW_FunctionsExt.ExtractAttribute(
            GeoW_FunctionsExt.FindObjects(>Component, "Name", objectName),
            path
          )
        ) == expectedCount;
    END TestCase;

  END FunctionTestTopic;

END TestSuite.
