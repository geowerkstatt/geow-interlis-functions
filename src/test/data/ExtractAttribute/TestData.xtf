            <TestSuite:TestCase ili:tid="test1">
                <TestSuite:description>Get attribute of a single Object</TestSuite:description>
                <TestSuite:path>Attr</TestSuite:path>
                <TestSuite:objectName>SingleObject</TestSuite:objectName>
                <TestSuite:expectedCount>1</TestSuite:expectedCount>
            </TestSuite:TestCase>
            <TestSuite:TestCase ili:tid="test2">
                <TestSuite:description>Get attribute of multiple Objects</TestSuite:description>
                <TestSuite:path>Attr</TestSuite:path>
                <TestSuite:objectName>MultipleObject</TestSuite:objectName>
                <TestSuite:expectedCount>2</TestSuite:expectedCount>
            </TestSuite:TestCase>
            <TestSuite:TestCase ili:tid="test3">
                <TestSuite:description>Get complex attribute of multiple Objects</TestSuite:description>
                <TestSuite:objectName>ComplexObjects</TestSuite:objectName>
                <TestSuite:path>Geom</TestSuite:path>
                <TestSuite:expectedCount>2</TestSuite:expectedCount>
            </TestSuite:TestCase>
            <TestSuite:TestCase ili:tid="test4">
                <TestSuite:description>Path is undefined</TestSuite:description>
                <TestSuite:objectName>SingleObject</TestSuite:objectName>
                <TestSuite:expectedCount>1</TestSuite:expectedCount>
            </TestSuite:TestCase>
            <TestSuite:TestCase ili:tid="test5">
                <TestSuite:description>Objects is empty</TestSuite:description>
                <TestSuite:objectName>DoesNotExist</TestSuite:objectName>
                <TestSuite:path>Attr</TestSuite:path>
                <TestSuite:expectedCount>0</TestSuite:expectedCount>
            </TestSuite:TestCase>
            <TestSuite:TestCase ili:tid="test6">
                <TestSuite:description>Attribute of object is undefined</TestSuite:description>
                <TestSuite:objectName>AttributesUndefined</TestSuite:objectName>
                <TestSuite:path>Attr</TestSuite:path>
                <TestSuite:expectedCount>0</TestSuite:expectedCount>
            </TestSuite:TestCase>
            <TestSuite:TestCase ili:tid="test7">
                <TestSuite:description>Failing test to protect against a validator that accepts everything.</TestSuite:description>
                <TestSuite:objectName>SingleObject</TestSuite:objectName>
                <TestSuite:path>Attr</TestSuite:path>
                <TestSuite:expectedCount>100</TestSuite:expectedCount>
